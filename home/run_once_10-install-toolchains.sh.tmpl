#!/bin/sh
# run_once: instala rustup + uv y las herramientas cargo del perfil.
# chezmoi re-ejecuta este script solo si su contenido cambia.
# Perfil: {{ .profile }}
set -eu

log() { printf '\033[1;34m[run_once:toolchains]\033[0m %s\n' "$1"; }

# --- rustup ---
if ! command -v rustup >/dev/null 2>&1; then
    log "Instalando rustup (toolchain stable)..."
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --no-modify-path
fi
# Asegura cargo en PATH para el resto del script
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# --- uv (Python por proyecto) ---
if ! command -v uv >/dev/null 2>&1; then
    log "Instalando uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# --- Componentes rustup y herramientas cargo (packages/cargo.txt) ---
# El perfil filtra 'both' vs '{{ .profile }}'. component:X -> rustup component add.
{{ $cargoFile := joinPath .chezmoi.sourceDir "../packages/cargo.txt" -}}
{{ range (include $cargoFile | splitList "\n") -}}
{{-   $line := trim . -}}
{{-   if and $line (not (hasPrefix "#" $line)) -}}
{{-     $fields := splitList " " $line -}}
{{-     $item := index $fields 0 -}}
{{-     $prof := "" -}}
{{-     if gt (len $fields) 1 }}{{ $prof = index $fields 1 }}{{ end -}}
{{-     if or (eq $prof "both") (eq $prof $.profile) -}}
{{-       if hasPrefix "component:" $item }}
rustup component add {{ trimPrefix "component:" $item }} || true
{{-       else }}
command -v {{ $item }} >/dev/null 2>&1 || cargo install {{ $item }}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end }}

log "Toolchains listas."
