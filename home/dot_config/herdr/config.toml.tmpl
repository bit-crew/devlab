{{ if eq .profile "vps" -}}
# ~/.config/herdr/config.toml — generado por chezmoi. Perfil: {{ .profile }}
# Tema: zenbones "dark warm". Colores desde la paleta central (.chezmoidata.yaml);
# cambia un color alli y herdr, helix y lazygit lo toman a la vez.

# Ya elegiste el modo: no vuelvas a mostrar el onboarding.
onboarding = false

[theme]
# Base calida con acentos naranja nativos; los tokens de abajo la afinan.
name = "vesper"

# Override de tokens sobre la base, desde la paleta central.
[theme.custom]
panel_bg = "{{ .palette.bg }}"
sidebar_bg = "{{ .palette.bg_dim }}"
active_row_bg = "{{ .palette.bg_sel }}"
selection_bg = "{{ .palette.bg_sel }}"
text = "{{ .palette.fg }}"
accent = "{{ .palette.orange }}"
yellow = "{{ .palette.yellow }}"
red = "{{ .palette.red }}"
green = "{{ .palette.green }}"
blue = "{{ .palette.blue }}"

[ui.toast]
delivery = "herdr"
{{- end }}
