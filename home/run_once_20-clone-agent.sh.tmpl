#!/bin/sh
# run_once: clona el repo de steering del agente. Solo VPS.
# Perfil: {{ .profile }}
set -eu

log() { printf '\033[1;34m[run_once:agent]\033[0m %s\n' "$1"; }

{{- if eq .profile "vps" }}
AGENT_HOME="$HOME/{{ .agent.home }}"
if [ ! -d "$AGENT_HOME/.git" ]; then
    log "Clonando steering en $AGENT_HOME..."
    git clone {{ .agent.repo | quote }} "$AGENT_HOME"
else
    log "Steering ya presente en $AGENT_HOME."
fi
{{- else }}
log "Perfil dc1: no se clona el agente."
{{- end }}
